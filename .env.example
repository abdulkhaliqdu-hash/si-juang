# ─────────────────────────────────────────────────────────────
# SI-JUANG — contoh konfigurasi environment
# Salin file ini menjadi `.env.local` untuk pengembangan lokal,
# dan daftarkan variabel yang sama di Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Kunci untuk menandatangani cookie sesi (WAJIB di produksi).
# Buat nilai acak, misal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ubah-nilai-ini-menjadi-string-acak-panjang

# Kredensial akun bawaan (dipakai saat basis data pertama kali disiapkan)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator12345

# (Opsional) Postgres serverless — Neon / Vercel Postgres / Supabase.
# Jika kosong, aplikasi otomatis berjalan dengan SQLite lokal.
# Untuk deployment serverless seperti Vercel, gunakan path writable seperti /tmp/sijuang.db.
# DATABASE_FILE=/tmp/sijuang.db
# DATABASE_URL=postgresql://user:password@host.neon.tech/sijuang?sslmode=require
